AGENTOS_OIDC_ISSUER=http://host.docker.internal:8088
AGENTOS_OIDC_PUBLIC_ISSUER=http://localhost:8088
AGENTOS_CLIENT_ID=your-client-id
AGENTOS_CLIENT_SECRET=your-client-secret
