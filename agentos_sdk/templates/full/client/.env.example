# AgentOS App Environment variables
# NOTE: The majority of the AGENTOS_* variables below are PROVISIONED from the platform dashboard.
# (client_id/secret/redirect/ui/issuer come from provision, not hand-typed).
# Copy the block from the platform dashboard when provisioning the agent and paste it below.

AGENT_SLUG=__SLUG__
AGENT_BASE_PATH=/a/__SLUG__/

# Database / App secrets
SECRET_KEY=your-secret-key-here
CONTACTS_ENCRYPTION_KEY=your-encryption-key-here

# GHCR credentials for watchtower and compose
# IMPORTANT: GHCR_USER must be lowercase (e.g. sachin-nltechnologies).
# GHCR_PAT should be a GitHub Classic PAT with read:packages scope.
GHCR_USER=sachin-nltechnologies
GHCR_PAT=your_read_packages_pat_here
